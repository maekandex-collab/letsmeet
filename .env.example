# Public site URL for Open Graph / social preview images (no trailing slash)
# Set this to your Coolify domain after deploy
NEXT_PUBLIC_SITE_URL=https://letsmeet.example.com

# LetsMeet backend (server-side proxy target)
LETSMEET_API_BASE_URL=https://mtn.lenhub.net

# Public base used by the browser to load uploaded media (profile photos)
NEXT_PUBLIC_LETSMEET_BASE_URL=https://mtn.lenhub.net

# WebSocket base for live chat + video calls (defaults to NEXT_PUBLIC_LETSMEET_BASE_URL)
# NEXT_PUBLIC_LETSMEET_WS_BASE_URL=wss://mtn.lenhub.net

# TURN / STUN for cross-network WebRTC (served by GET /api/ice-servers)
# Required when peers are on different networks (host/LAN candidates are not enough).
# TURN_URLS=turn:turner.lenhub.net:3478?transport=udp,turn:turner.lenhub.net:3478?transport=tcp
# TURN_USERNAME=webrtc
# TURN_CREDENTIAL=YourStrongPassword123!
# STUN_URLS=stun:stun.l.google.com:19302

# Optional Upstash Redis for shared media cache in production (multi-instance)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Set to 0 to disable on-disk media cache (use Redis or no cache instead)
# LETSMEET_MEDIA_DISK_CACHE=1
